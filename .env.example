# Jupiter Perpetuals Bot Configuration
# Copy this file to .env and fill in your values

# Private key for your Solana wallet (base58 encoded)
# You can get this from Phantom wallet or generate with solana-keygen
PRIVATE_KEY=your_base58_encoded_private_key_here

# Optional: Keeper signers required for the "instant" instructions.
# If omitted, the bot will fall back to using PRIVATE_KEY for both.
KEEPER_PRIVATE_KEY=
API_KEEPER_PRIVATE_KEY=

# Solana RPC URL
# Options:
# - Mainnet: https://api.mainnet-beta.solana.com (rate limited)
# - QuickNode: https://your-endpoint.solana-mainnet.quiknode.pro/your-key/
# - Helius: https://mainnet.helius-rpc.com/?api-key=your-key
# - Triton: https://your-endpoint.rpcpool.com/your-key
RPC_URL=https://api.mainnet-beta.solana.com

# Transaction commitment level
# Options: processed | confirmed | finalized
# - processed: fastest, but may be rolled back
# - confirmed: recommended for most use cases
# - finalized: slowest, but guaranteed
COMMITMENT=confirmed

# Slippage tolerance (percentage)
# This protects against price movement during transaction execution
# Example: 0.5 = 0.5% slippage tolerance
SLIPPAGE_TOLERANCE=0.5
